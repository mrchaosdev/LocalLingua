<Window x:Class="LocalLingua.Overlay.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="LocalLingua Overlay" Width="650" Height="220" MinWidth="390" MinHeight="150"
  Topmost="True" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
  ShowInTaskbar="True" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen">
 <Border Background="#E91C2230" CornerRadius="13" BorderBrush="#727F98" BorderThickness="1" Margin="7" Padding="15">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0" LastChildFill="True" MouseLeftButtonDown="DragBar_MouseLeftButtonDown">
     <Button DockPanel.Dock="Right" Content="✕" Width="26" Height="24" Background="#32394B" Foreground="White" BorderThickness="0" Click="Close_Click" ToolTip="Close overlay"/>
     <TextBlock Name="StatusText" Text="● Connecting to local engine..." Foreground="#B0BDF6" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </DockPanel>
   <TextBlock Grid.Row="1" Name="VietnameseText" Foreground="White" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"
      VerticalAlignment="Center" Text="Phụ đề tiếng Việt sẽ xuất hiện ở đây." Margin="0,15,0,12"/>
   <TextBlock Grid.Row="2" Name="EnglishText" Foreground="#AEBACA" FontSize="13" TextWrapping="Wrap" Text="English source (if available)"/>
  </Grid>
 </Border>
</Window>
