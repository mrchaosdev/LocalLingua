# Copy to .env on the target GPU PC AFTER installing and downloading models.
# Relative paths are resolved from services/engine.
ASR_BACKEND=whisper
TRANSLATE_BACKEND=ollama
WHISPER_MODEL=../../models/faster-whisper-small.en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=int8_float16
OFFLINE_MODE=1
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hf.co/Qwen/Qwen3-4B-GGUF:Q4_K_M
AUDIO_RMS_THRESHOLD=0.006
# Optional real VAD; download official silero_vad.onnx to this path before startup.
VAD_MODEL_PATH=../../models/silero_vad.onnx
