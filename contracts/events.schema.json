{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalLingua caption v2",
  "type": "object",
  "required": [
    "type",
    "phase",
    "utterance_id",
    "revision",
    "is_final",
    "english",
    "vietnamese",
    "created_at_ms"
  ],
  "properties": {
    "type": {
      "const": "caption"
    },
    "phase": {
      "enum": [
        "transcript.partial",
        "transcript.final",
        "translation.partial",
        "translation.final"
      ]
    },
    "utterance_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "is_final": {
      "type": "boolean"
    },
    "english": {
      "type": "string"
    },
    "vietnamese": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "created_at_ms": {
      "type": "integer"
    },
    "audio_start_ms": {
      "type": "number"
    },
    "audio_end_ms": {
      "type": "number"
    },
    "speech_end_mono_ms": {
      "type": "number"
    },
    "emitted_mono_ms": {
      "type": "number"
    },
    "clock_uncertainty_ms": {
      "type": "number"
    },
    "trace_id": {
      "type": "string",
      "maxLength": 150
    },
    "clock_calibrated": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}